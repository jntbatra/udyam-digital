# AWS credentials come from the default chain (~/.aws/credentials or env vars).
# Chat advisor: Gemma 4 31B on Amazon Bedrock Mantle (OpenAI-compatible /openai/v1 route)
MANTLE_REGION=us-east-1
MANTLE_MODEL=google.gemma-4-31b
# Set to "guided" to run the advisor fully offline (deterministic flow, no LLM cost)
# ADVISOR_MODE=guided

# Smart KYC OCR: AWS Textract DetectDocumentText
TEXTRACT_REGION=ap-south-1
# Local OCR cache for the synthetic specimen documents (avoids re-billing). "off" in production.
OCR_CACHE=on

# Voice mode: Amazon Nova Sonic bidirectional streaming
VOICE_PROVIDER=nova
VOICE_PORT=3001
SONIC_MODEL_ID=amazon.nova-2-5-sonic
SONIC_REGION=us-east-1
SONIC_VOICE=kiara
SONIC_MAX_SECONDS=600
NEXT_PUBLIC_VOICE_PORT=3001

# Sarvam voice mode (set VOICE_PROVIDER=sarvam to enable multilingual Indian voice).
# Keep this key server-side; never expose it as NEXT_PUBLIC_*.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
