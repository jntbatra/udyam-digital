{
  "name": "udyam-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "voice": "node --env-file=.env.local --import tsx voice-server.mts",
    "dev:all": "npm run voice & npm run dev",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "check:engine": "tsx scripts/engine-check.ts",
    "check:kyc": "tsx scripts/kyc-eval.mts",
    "ocr:reextract": "tsx scripts/reextract.mts",
    "train:propensity": "python3 scripts/train_propensity.py",
    "gateway": "tsx gateway.mts",
    "sync": "bash scripts/auto-sync.sh",
    "host": "npm run sync & npm run voice & npm run gateway & npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@aws-sdk/client-textract": "^3.1164.0",
    "@aws-sdk/credential-provider-node": "^3.972.94",
    "@smithy/node-http-handler": "^4.14.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "csv-parse": "^7.0.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sarvamai": "^1.1.17",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
